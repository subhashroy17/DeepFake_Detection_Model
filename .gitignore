# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Project specific: large files, datasets, trained model weights, and logs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/train/*
!data/train/.gitkeep
data/val/*
!data/val/.gitkeep
data/test/*
!data/test/.gitkeep
data/unseen_test/*
!data/unseen_test/.gitkeep

models/*.keras
models/*.h5
!models/.gitkeep

logs/*.log
!logs/.gitkeep

# Kaggle tokens and credentials (NEVER commit secrets)
kaggle.json
.kaggle/
